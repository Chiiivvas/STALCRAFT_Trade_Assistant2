--- /dev/null
+++ b/stalcraft_trade_assistant_v2/tests/test_seed_icon_templates.py
@@ -0,0 +1,26 @@
+from pathlib import Path
+
+import cv2
+
+from app.vision.icons import extract_icon_crop, extract_features, similarity
+from app.paths import SEED_ICONS_DIR
+
+
+def test_seed_icon_png_is_not_cropped_twice():
+    for path in SEED_ICONS_DIR.glob("*.png"):
+        image = cv2.imread(str(path))
+        assert image is not None
+        crop = extract_icon_crop(image)
+        assert crop.shape == image.shape
+        assert similarity(extract_features(crop), extract_features(image)) > 0.999
+
+
+def test_full_card_still_uses_icon_roi():
+    import numpy as np
+    from app.vision import layout
+
+    card = np.zeros((76, 74, 3), dtype=np.uint8)
+    crop = extract_icon_crop(card)
+    expected_h = round(layout.ICON_BOX[3] * 76) - round(layout.ICON_BOX[1] * 76)
+    expected_w = round(layout.ICON_BOX[2] * 74) - round(layout.ICON_BOX[0] * 74)
+    assert crop.shape[:2] == (expected_h, expected_w)
